rules_version = '2';

// Velora — Firestore security rules
// -----------------------------------------------------------------
// Copy this file's contents into:
// Firebase Console -> Firestore Database -> Rules -> paste -> Publish
// -----------------------------------------------------------------
//   bookings  -> anyone can CREATE (public booking form). Only the
//                signed-in admin (Ronadisa) can read/update/delete.
//   portfolio -> anyone can READ (public gallery). Only the admin
//                can add, edit or delete photos.
//   settings  -> anyone can READ (public contact info + social
//                links). Only the admin can edit them. Includes the
//                "socials" subcollection under settings/site.
// -----------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    match /bookings/{docId} {

      allow create: if
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.email.size() < 150 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 6 &&
        request.resource.data.phone.size() < 30 &&
        request.resource.data.birthdate is string &&
        request.resource.data.governorate is string &&
        request.resource.data.city is string &&
        request.resource.data.city.size() < 150 &&
        request.resource.data.purpose in ['book', 'contact'] &&
        (!('message' in request.resource.data) || request.resource.data.message.size() < 1000);

      // Only signed-in (admin) users can view, update or delete entries.
      allow read, update, delete: if request.auth != null;
    }

    match /portfolio/{docId} {
      // Anyone can view the public gallery.
      allow read: if true;

      // Only the signed-in admin can add or edit a photo, and only
      // if it looks like a real, reasonably-sized entry.
      allow create, update: if request.auth != null &&
        request.resource.data.title is string &&
        request.resource.data.title.size() < 150 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() < 60 &&
        request.resource.data.imageData is string &&
        request.resource.data.imageData.size() < 900000;

      allow delete: if request.auth != null;
    }

    match /settings/{docId} {
      // Public contact info (email/phone) — anyone can read it,
      // only the admin can change it.
      allow read: if true;
      allow write: if request.auth != null;

      match /socials/{socialId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
